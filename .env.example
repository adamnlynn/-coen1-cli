# coen-cli reads nothing from a .env file at runtime. Its connection and its model live in
# ~/.coen/config.json (0600), written by `coen login`, `coen setup` and `coen config`.
#
# This file documents the environment variables that OVERRIDE that config, which is what you want
# in CI, a container, or a shared box where you would rather not write a key to disk. An env var
# always wins over the stored value.

# --- Coen 1 connection ---
# Where the CLI talks to. Defaults to the hosted service; point it at your own if you run one.
# COEN_WEB_URL=https://stack.adamnlynn.com

# --- Model, for `coen chat` (bring your own pay-per-token key — no subscription) ---
# Set ONE of these. The CLI auto-detects the provider from whichever is present.
GOOGLE_GENERATIVE_AI_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# COEN_PROVIDER=google          # force one, when more than one key is set (google|anthropic|openai)
# COEN_MODEL=gemini-3.5-flash   # override that provider's default model

# --- Where state lives, and which one ---
# COEN_HOME=~/.coen             # move the whole config + session directory
# COEN_PROFILE=work             # a second, separate account on the same machine

# --- The daemon (serves Coen's tools to other agents on this machine, loopback only) ---
# COEN_DAEMON_PORT=0            # 0 = pick a free port

# ⚠ Turns OFF the confirmation prompt before any tool that WRITES to your record. Only set this
# where you have already decided to trust whatever is driving the CLI — an unattended agent with
# this set can log, tick and delete without asking you first.
# COEN_CONFIRM_WRITES=false
