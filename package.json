{
  "name": "@coen1/cli",
  "version": "0.1.1",
  "description": "Coen 1 in your terminal — check in, tick habits, record decisions and read what came through, from the same record as the web app. A chat with your own model key is one command away.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adamnlynn/-coen1-cli.git"
  },
  "homepage": "https://github.com/adamnlynn/-coen1-cli#readme",
  "bugs": {
    "url": "https://github.com/adamnlynn/-coen1-cli/issues"
  },
  "keywords": [
    "coen",
    "journal",
    "cli",
    "mcp",
    "emotional-tracking",
    "terminal"
  ],
  "type": "module",
  "bin": {
    "coen": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/index.tsx",
    "start": "node dist/index.js"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": "Adam & Lynn Incorporated",
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.40",
    "@ai-sdk/google": "^4.0.49",
    "@ai-sdk/mcp": "^2.0.34",
    "@ai-sdk/openai": "^4.0.45",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "ai": "^7.0.74",
    "chalk": "^5.3.0",
    "gradient-string": "^2.0.2",
    "ink": "^5.1.0",
    "ink-select-input": "^6.0.0",
    "ink-spinner": "^5.0.0",
    "ink-text-input": "^6.0.0",
    "marked": "^12.0.0",
    "marked-terminal": "^7.1.0",
    "open": "^11.0.0",
    "react": "^18.3.1",
    "wrap-ansi": "^9.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/gradient-string": "^1.1.5",
    "@types/marked-terminal": "^6.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
